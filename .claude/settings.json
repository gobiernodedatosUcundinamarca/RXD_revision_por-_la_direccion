{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(corepack:*)"
    ],
    "ask": [
      "Edit(.claude/CLAUDE.md)",
      "Write(.claude/CLAUDE.md)",
      "Edit(.claude/rules/**)",
      "Write(.claude/rules/**)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/recordar-reglas.mjs"],
            "timeout": 15,
            "statusMessage": "Revisando si las reglas quedaron al día…"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
